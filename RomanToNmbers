#include <iostream>
#include <unordered_map>
#include <string>
using namespace std;

class Solution {
public:
    int romanToInt(string s) {
        unordered_map<char, int> m = {
            {'I',1}, {'V',5}, {'X',10},
            {'L',50}, {'C',100},
            {'D',500}, {'M',1000}
        };

        int res = 0;

        for(int i = 0; i < s.length(); i++) {
            // If current < next → subtract
            if(i + 1 < s.length() && m[s[i]] < m[s[i+1]]) {
                res -= m[s[i]];
            } 
            // Else → add
            else {
                res += m[s[i]];
            }
        }

        return res;
    }
};

int main() {
    Solution obj;

    string s;
    cout << "Enter Roman numeral: ";
    cin >> s;

    int result = obj.romanToInt(s);

    cout << "Integer value: " << result << endl;

    return 0;
}